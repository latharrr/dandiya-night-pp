# Copy to server/.env, fill in, then: npm run start:env   (or: node --env-file=.env server.js)
# Never commit .env. Full list and meaning: HANDOFF.md §3 and §3b.

NODE_ENV=production
PORT=8080
DATA_DIR=/var/lib/dandiya-nights
TRUST_PROXY=1
ADMIN_KEY=change-me-to-a-long-random-value
# PICAPOOL_WEBHOOK_SECRET=        # only once Picapool's backend pushes account changes

# --- Login codes on WhatsApp (Meta Cloud API) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_OTP_LANG=en
# WHATSAPP_OTP_BUTTON=0           # only if the template has no copy-code button

# --- "New pair" alert on WhatsApp (leave the template empty to switch it off) ---
WHATSAPP_MATCH_TEMPLATE=
WHATSAPP_MATCH_LANG=en
WHATSAPP_MATCH_VARS=me,name
# WHATSAPP_MATCH_BUTTON_VAR=link

# --- Login codes by SMS (MSG91, DLT-approved template) ---
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_MODE=otp
# MSG91_OTP_VAR=OTP               # flow mode only

OTP_CHANNELS=whatsapp,sms
APP_URL=https://dandiya.picapool.tech
# SHOW_COUNTS=0                   # hide "184 girls from North Campus are going"
# SAMPLE_PROFILES=0               # no sample people in the guest peek
